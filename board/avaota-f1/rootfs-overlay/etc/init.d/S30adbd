#!/bin/sh

# Tina's V821 adbd flow is:
#   1. mount configfs and FunctionFS;
#   2. create the ffs.adb configfs function;
#   3. start adbd so it writes the FunctionFS descriptors;
#   4. bind the gadget to the Sunxi UDC.
#
# Buildroot supplies /usr/bin/adbd from its android-tools package.  This
# service keeps the Tina ordering and paths, but uses the standard Buildroot
# BusyBox init instead of Tina's procd service and does not require a Tina
# checkout at runtime.

ADBD=/usr/bin/adbd
PIDFILE=/var/run/adbd.pid
CONFIGFS=/sys/kernel/config
GADGET=${CONFIGFS}/usb_gadget/g1
CONFIG=${GADGET}/configs/c.1
FUNCTION=${GADGET}/functions/ffs.adb
FFS_DIR=/dev/usb-ffs/adb
ADB_VID=${AVAOTA_ADB_VID:-0x1f3a}
ADB_PID=${AVAOTA_ADB_PID:-0x1002}

get_serial() {
	serial=avaota-f1
	for arg in $(cat /proc/cmdline 2>/dev/null); do
		case "$arg" in
			androidboot.serialno=*) serial=${arg#androidboot.serialno=} ;;
			snum=*) serial=${arg#snum=} ;;
		esac
	done
	printf '%s\n' "$serial"
}

ensure_configfs() {
	if [ ! -d "${CONFIGFS}/usb_gadget" ]; then
		mkdir -p "${CONFIGFS}"
		mount -t configfs none "${CONFIGFS}" || return 1
	fi
	[ -d "${CONFIGFS}/usb_gadget" ]
}

unbind_gadget() {
	if [ -e "${GADGET}/UDC" ] && [ -n "$(cat "${GADGET}/UDC" 2>/dev/null)" ]; then
		echo "" > "${GADGET}/UDC" || true
	fi
}

ensure_gadget() {
	[ -d "${GADGET}" ] || mkdir "${GADGET}" || return 1
	[ -d "${GADGET}/strings/0x409" ] || mkdir -p "${GADGET}/strings/0x409" || return 1
	[ -d "${CONFIG}" ] || mkdir "${CONFIG}" || return 1
	[ -d "${CONFIG}/strings/0x409" ] || mkdir -p "${CONFIG}/strings/0x409" || return 1

	echo "${ADB_VID}" > "${GADGET}/idVendor"
	echo "${ADB_PID}" > "${GADGET}/idProduct"
	echo "Allwinner Technology Inc." > "${GADGET}/strings/0x409/manufacturer"
	echo "Avaota-F1 ADB" > "${GADGET}/strings/0x409/product"
	echo "0xc0" > "${CONFIG}/bmAttributes"
	echo "500" > "${CONFIG}/MaxPower"
	echo "ADB" > "${CONFIG}/strings/0x409/configuration"
	echo "$(get_serial)" > "${GADGET}/strings/0x409/serialnumber"
}

ensure_functionfs() {
	mkdir -p /dev/usb-ffs "${FFS_DIR}" || return 1
	if ! grep -q "[[:space:]]${FFS_DIR}[[:space:]]functionfs[[:space:]]" /proc/mounts 2>/dev/null &&
	   [ ! -e "${FFS_DIR}/ep0" ]; then
		mount -o uid=2000,gid=2000 -t functionfs adb "${FFS_DIR}" || return 1
	fi
}

ensure_function() {
	[ -d "${FUNCTION}" ] || mkdir "${FUNCTION}" || return 1
	[ -L "${CONFIG}/ffs.adb" ] || {
		[ ! -e "${CONFIG}/ffs.adb" ] || rm -f "${CONFIG}/ffs.adb"
		ln -s "${FUNCTION}" "${CONFIG}/ffs.adb" || return 1
	}
}

adbd_running() {
	[ -s "${PIDFILE}" ] || return 1
	pid=$(cat "${PIDFILE}" 2>/dev/null || true)
	[ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

start() {
	[ -x "${ADBD}" ] || {
		echo "adbd: ${ADBD} is not installed" >&2
		return 1
	}
	adbd_running && return 0

	ensure_configfs || {
		echo "adbd: configfs is unavailable" >&2
		return 1
	}
	unbind_gadget
	ensure_gadget || return 1
	ensure_functionfs || {
		echo "adbd: FunctionFS is unavailable" >&2
		return 1
	}
	ensure_function || return 1

	start-stop-daemon -S -b -m -p "${PIDFILE}" -x "${ADBD}" -- -D || return 1

	# The Tina adbd variant binds the UDC after publishing FunctionFS
	# descriptors.  Keep that behavior for Buildroot's adbd as well, while
	# allowing a daemon that performs the bind itself to win the race.
	tries=0
	while [ "${tries}" -lt 5 ]; do
		[ -n "$(cat "${GADGET}/UDC" 2>/dev/null)" ] && return 0
		sleep 1
		tries=$((tries + 1))
	done

	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	if [ -n "${udc}" ] && [ -e "${GADGET}/UDC" ] &&
	   [ -z "$(cat "${GADGET}/UDC" 2>/dev/null)" ]; then
		echo "${udc}" > "${GADGET}/UDC" || {
			echo "adbd: failed to bind UDC ${udc}" >&2
			return 1
		}
	fi
	return 0
}

stop() {
	unbind_gadget
	if [ -s "${PIDFILE}" ]; then
		start-stop-daemon -K -p "${PIDFILE}" 2>/dev/null || true
		rm -f "${PIDFILE}"
	fi
	umount "${FFS_DIR}" 2>/dev/null || true
	[ -L "${CONFIG}/ffs.adb" ] && rm -f "${CONFIG}/ffs.adb"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit $?
